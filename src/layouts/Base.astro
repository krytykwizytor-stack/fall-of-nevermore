---
import '../styles/global.css';
import { chapters } from '../data/chapters.js';
const {title='Dokument projektowy',active=''}=Astro.props;
---
<!doctype html><html lang="pl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Fall of Nevermore — publiczny dokument projektowy neogotyckiego larpa."/><title>{title} — Fall of Nevermore</title></head><body><div class="layout">
<aside id="sidebar" class="sidebar"><a class="identity" href="/"><span class="seal">FN</span><span><small>Ravensmoor · 1905</small><strong>Fall of Nevermore</strong></span></a><label class="search-label" for="chapter-search">Szukaj rozdziału</label><input id="chapter-search" type="search" placeholder="Tytuł lub temat…"/><nav aria-label="Rozdziały dokumentu"><span class="nav-title">Spis treści</span><a class:list={['nav-item',{active:active===''}]} href="/"><em>00</em> Strona tytułowa</a>{chapters.map(c=><a class:list={['nav-item',{active:active===c.slug}]} href={`/dokument/${c.slug}/`} data-title={`${c.title} ${c.description}`.toLowerCase()}><em>{c.number}</em>{c.title}</a>)}<p id="no-results" hidden>Brak pasujących rozdziałów.</p></nav><div class="sidebar-foot">A Gothic Tale · Anno Domini MCMV</div></aside>
<div class="main-frame"><header class="masthead"><button type="button" id="menu" aria-controls="sidebar" aria-expanded="false">☰ &nbsp; Spis treści</button><span>Fall of Nevermore · Anno Domini MCMV</span><a href="/">F / N</a></header><main><slot/></main><footer class="footer"><span>Fall of Nevermore</span><span>A Gothic LARP · 1905</span></footer></div></div>
<script>const b=document.querySelector('#menu');const s=document.querySelector('#sidebar');b?.addEventListener('click',()=>{const open=s?.classList.toggle('open')??false;b.setAttribute('aria-expanded',String(open));});const inp=document.querySelector('#chapter-search');const links=[...document.querySelectorAll('[data-title]')];inp?.addEventListener('input',()=>{const q=inp.value.trim().toLocaleLowerCase('pl');let n=0;links.forEach(a=>{a.hidden=!(a.dataset.title||'').includes(q);if(!a.hidden)n++;});const empty=document.querySelector('#no-results');if(empty)empty.hidden=n>0;});</script>
</body></html>
