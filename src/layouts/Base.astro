---
import '../styles/global.css';
import '../styles/editorial-rich.css';
import '../styles/nevermore-ambient.css';
import '../styles/nevermore-literary.css';
import { chapters } from '../data/chapters.js';
const {title='Dokument projektowy',active=''}=Astro.props;
const organizerLogo='data:image/webp;base64,';
---
<!doctype html><html lang="pl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Fall of Nevermore — publiczny dokument projektowy neogotyckiego larpa."/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title} — Fall of Nevermore</title></head><body><div class="layout">
<aside id="sidebar" class="sidebar"><a class="identity" href="/"><span class="seal">FN</span><span><strong>Fall of Nevermore</strong></span></a><label class="search-label" for="chapter-search">Szukaj rozdziału</label><input id="chapter-search" type="search" placeholder="Tytuł lub temat…"/><nav aria-label="Rozdziały dokumentu"><span class="nav-title">Spis treści</span><a class:list={['nav-item',{active:active===''}]} href="/"><em>00</em> Strona tytułowa</a>{chapters.map(c=><a class:list={['nav-item',{active:active===c.slug}]} href={`/dokument/${c.slug}/`} data-title={`${c.title} ${c.description}`.toLowerCase()}><em>{c.number}</em>{c.title}</a>)}<p id="no-results" hidden>Brak pasujących rozdziałów.</p></nav></aside>
<div class="main-frame"><div class="ink-ambience" aria-hidden="true"><span class="ink-blot ink-blot--first"></span><span class="ink-blot ink-blot--second"></span><span class="ink-blot ink-blot--third"></span><span class="ink-side-quill ink-side-quill--first"></span><span class="ink-side-quill ink-side-quill--second"></span></div><header class="masthead"><button type="button" id="menu" aria-controls="sidebar" aria-expanded="false">☰ &nbsp; Spis treści</button><a class="masthead-logo" href="/" aria-label="Strona główna Fall of Nevermore"><img src="/images/identity/fon-logo-black.png" width="700" height="295" alt="" decoding="async"/></a></header><main><slot/></main><footer class="footer organizer-footer"><a class="organizer-signature" href="/dokument/informacje/#zespol"><img src={organizerLogo} width="73" height="100" alt="" loading="lazy"/><span>Organizator<br/><strong>Larphobia</strong></span></a><a class="organizer-contact" href="mailto:larphobia@gmail.com">Kontakt</a></footer></div></div>
<script>const b=document.querySelector('#menu');const s=document.querySelector('#sidebar');b?.addEventListener('click',()=>{const open=s?.classList.toggle('open')??false;b.setAttribute('aria-expanded',String(open));});const inp=document.querySelector('#chapter-search');const links=[...document.querySelectorAll('[data-title]')];inp?.addEventListener('input',()=>{const q=inp.value.trim().toLocaleLowerCase('pl');let n=0;links.forEach(a=>{a.hidden=!(a.dataset.title||'').includes(q);if(!a.hidden)n++;});const empty=document.querySelector('#no-results');if(empty)empty.hidden=n>0;});
const signets=[...document.querySelectorAll('.chapter-signet')];
if(signets.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  const ornamentObserver=new IntersectionObserver(entries=>{
    for(const entry of entries){
      if(!entry.isIntersecting)continue;
      entry.target.classList.add('ornament-revealed');
      ornamentObserver.unobserve(entry.target);
    }
  },{threshold:0.25});
  signets.forEach(signet=>ornamentObserver.observe(signet));
}
const blots=[...document.querySelectorAll('.ink-blot')];
if(blots.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  blots.forEach(blot=>blot.classList.add('ink-waiting'));
  const inkObserver=new IntersectionObserver(entries=>{
    for(const entry of entries){
      if(!entry.isIntersecting)continue;
      entry.target.classList.remove('ink-waiting');
      entry.target.classList.add('ink-bloom');
      inkObserver.unobserve(entry.target);
    }
  },{rootMargin:'60px 0px',threshold:0.01});
  blots.forEach(blot=>inkObserver.observe(blot));
}
</script>
</body></html>

<style>
.organizer-footer{align-items:center;justify-content:space-between;gap:18px;padding:18px 6%;font-size:13px;color:#493b3d}.organizer-signature{display:flex;align-items:center;gap:12px;text-decoration:none}.organizer-signature img{width:35px;height:auto;display:block}.organizer-signature span{line-height:1.4}.organizer-signature strong{font-size:15px;font-weight:600}.organizer-contact{text-decoration:underline;text-underline-offset:4px}.masthead{justify-content:flex-end}@media(max-width:900px){.masthead{justify-content:space-between}}
</style>
