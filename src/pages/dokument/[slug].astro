---
import Base from '../../layouts/Base.astro';
import { chapters } from '../../data/chapters.js';
import { cast } from '../../data/cast.js';
import { familyNotes } from '../../data/familyNotes.js';
import { roleContentAdvisories, threadTagDescriptions } from '../../data/role-content-advisories.js';
import Genealogy from '../../components/Genealogy.astro';
import TarotCard from '../../components/TarotCard.astro';
import {deck,tarotByArcana,tarotReady} from '../../data/tarot.js';
import PracticalInfo from '../../components/PracticalInfo.astro';
import EpochGuide from '../../components/EpochGuide.astro';
import InkBloom from '../../components/InkBloom.astro';
import { approvedPortraitsA } from '../../data/approved-portraits-a.js';
import { approvedPortraitsB } from '../../data/approved-portraits-b.js';
import { approvedPortraitsC } from '../../data/approved-portraits-c.js';
import { approvedPortraitsD } from '../../data/approved-portraits-d.js';
const portraits={...approvedPortraitsA,...approvedPortraitsB,...approvedPortraitsC,...approvedPortraitsD};
export function getStaticPaths(){return chapters.map(chapter=>({params:{slug:chapter.slug},props:{chapter}}));}
const {chapter}=Astro.props;
const index=chapters.findIndex(c=>c.slug===chapter.slug);
const previous=chapters[index-1],next=chapters[index+1];
const sectionKey=(heading)=>heading.toLowerCase().replaceAll('ł','l').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const importantRule=/^(Efekt opisany na karcie jest obowiązkowy\.|O wystąpieniu tego stanu decyduje wyłącznie MG|Każda definitywna śmierć postaci wymaga|Kontakt fizyczny wymaga zgody|Udział w blackboxie jest dobrowolny|Uczestnicy poruszający się poza postacią|Przestrzenie i pomieszczenia wyłączone|Rozgrywka nie zostaje formalnie zawieszona)/;
const mgRule=/^(Każdy pojedynek odbywa się|Uczestnicy mogą inicjować własne seanse|Konsultacji z Mistrzem Gry wymagają|Od sobotnich godzin popołudniowych|Śmierć postaci przed tym okresem|Zaostrzenie objawów następuje)/;
const actLabels={'piatek-przybycie-gosci':'Akt I','sobota-dzien-wesela':'Akt II','niedziela':'Epilog'};
---
<Base title={chapter.title} active={chapter.slug}><article class:list={["article", `article--${chapter.slug}`]}><div class="article-meta"><a href="/">← Spis treści</a><span>Rozdział {chapter.number} / {chapters.at(-1)?.number}</span></div><div class="article-head"><span class="chapter-signet" aria-hidden="true"></span><span class="chapter-watermark">{chapter.number}</span><h1>{chapter.title}</h1><p>{chapter.description}</p></div><div class="ornament-line"><InkBloom compact={true}/></div>{chapter.slug==='mechanika' && <nav class="rules-index" aria-label="Indeks mechanik"><span class="rules-index-title">Indeks zasad</span><div>{chapter.sections.map((section,i)=>section.level!==3 && <a href={`#sekcja-${i+1}`}>{section.heading}</a>)}</div></nav>}<div class="article-body">{chapter.slug==='informacje' ? <PracticalInfo/> : chapter.slug==='produkcja' ? <EpochGuide/> : chapter.sections ? chapter.sections.map((section, i) => <section class:list={["chapter-section", `chapter-section--${sectionKey(section.heading)}`, {"rule-subsection":chapter.slug==="mechanika" && section.level===3,"chapter-section--crowe":chapter.slug==="swiat" && section.heading==="Rodzina Crowe\'ów"}]} id={`sekcja-${i+1}`} aria-labelledby={`section-${i+1}`}>{chapter.slug==="dramaturgia" && actLabels[sectionKey(section.heading)] && <span class="act-kicker">{actLabels[sectionKey(section.heading)]}</span>}{section.level===3 ? <h3 class="mechanics-subheading" id={`section-${i+1}`}>{section.heading}</h3> : <h2 id={`section-${i+1}`}>{section.heading}</h2>}{section.paragraphs.map((p,j)=><><p class:list={[{
"rule-principle":chapter.slug==="mechanika" && p==="Dramat ponad mechanikę.",
"rule-important":chapter.slug==="mechanika" && importantRule.test(p),
"rule-mg":chapter.slug==="mechanika" && mgRule.test(p),
"rule-prohibition":chapter.slug==="mechanika" && /^(Zabronione jest|Wszelkie rekwizyty broni wymagają)/.test(p),
"rule-step":chapter.slug==="mechanika" && /^\d+\. /.test(p),
"rule-gesture":chapter.slug==="mechanika" && /^(Kciuk w górę|Falująca dłoń|Kciuk w dół) —/.test(p),
"rule-declaration":chapter.slug==="mechanika" && /^Deklaracje (organizatorskie|graczowskie) —/.test(p),
"rule-list":chapter.slug==="mechanika" && /^(Śmierci postaci\.|Zatrucia postaci\.|Długotrwałej zmiany jej stanu fizycznego\.)$/.test(p),
"mechanics-note":chapter.slug==="mechanika" && /^(GREEN|YELLOW|RED|BŁĘKITNE ŚWIATŁO|FIOLETOWE ŚWIATŁO)\b/.test(p),
"mechanics-note--green":chapter.slug==="mechanika" && p.startsWith("GREEN"),
"mechanics-note--yellow":chapter.slug==="mechanika" && p.startsWith("YELLOW"),
"mechanics-note--red":chapter.slug==="mechanika" && p.startsWith("RED"),
"mechanics-note--blue":chapter.slug==="mechanika" && p.startsWith("BŁĘKITNE ŚWIATŁO"),
"mechanics-note--violet":chapter.slug==="mechanika" && p.startsWith("FIOLETOWE ŚWIATŁO")
}]}>{chapter.slug==="mechanika" && /^(GREEN|YELLOW|RED|Kciuk w górę|Falująca dłoń|Kciuk w dół|Deklaracje organizatorskie|Deklaracje graczowskie) —/.test(p) ? <><strong>{p.split(" — ")[0]}</strong><span>{p.slice(p.indexOf(" — "))}</span></> : p}</p>{j===0 && section.plates && <div class:list={["mechanics-plates",{"mechanics-plates--lights":section.heading==="Widma i manifestacje"}]}>{section.plates.map(plate=><div class={`mechanics-plate mechanics-plate--${plate.symbol}`}><svg viewBox="0 0 100 100" width="70" height="70" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">{plate.symbol==="eye" ? <><circle cx="50" cy="50" r="44"/><circle cx="50" cy="50" r="39"/><path d="M13 50 Q50 12 87 50 Q50 88 13 50Z"/><circle cx="50" cy="50" r="15"/><circle cx="50" cy="50" r="7" fill="currentColor"/></> : plate.symbol==="heart" ? <><circle cx="50" cy="50" r="44"/><circle cx="50" cy="50" r="39"/><path d="M50 31 C29 8 11 40 30 60 L50 80 L70 60 C89 40 71 8 50 31Z"/><path d="M19 49H35L43 36L51 63L59 46H80"/></> : plate.symbol==="hourglass" ? <><circle cx="50" cy="50" r="44"/><circle cx="50" cy="50" r="39"/><path d="M30 23H70M30 77H70M34 23C34 43 45 43 50 50C55 43 66 43 66 23M34 77C34 57 45 57 50 50C55 57 66 57 66 77"/><path d="M38 73L50 60L62 73Z M42 34H58L50 43Z" fill="currentColor"/></> : <><circle cx="50" cy="50" r="43" opacity=".3"/><circle cx="50" cy="50" r="35" opacity=".45"/><path d="M50 18C38 18 33 28 34 42L22 84H78L66 42C67 28 62 18 50 18Z" fill="currentColor" opacity=".8"/></>}</svg><h3>{plate.title}</h3>{plate.latin && <em>{plate.latin}</em>}<p>{plate.text}</p></div>)}</div>}</>)}</section>) : chapter.slug==='postacie' ? <div class="cast-index"><div class="cast-intro">{chapter.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div><p class="cast-instruction">Wybierz nazwisko w rodowodzie lub rozwiń portret w katalogu. Możesz również wyszukać postać po imieniu, Arkanie lub hashtagu.</p><label for="cast-search">Szukaj postaci</label><input id="cast-search" type="search" placeholder="Imię, nazwisko, Arkana lub hashtag"/><Genealogy /><div class="cast-catalog-heading"><h2>Portrety mieszkańców i gości</h2><p>Z notatek pewnego gościa Nevermore Hall.</p></div>
<div class="cast-tags-explainer">
  <p>Hashtagi podpowiadają, jakich wątków można spodziewać się w grze. Możesz wyszukiwać według nich postaci.</p>
  <details class="cast-tags-glossary">
    <summary><span aria-hidden="true">✥</span> Co oznaczają hashtagi? <span aria-hidden="true">⌄</span></summary>
    <dl class="cast-tags-glossary-grid">
      {Object.entries(threadTagDescriptions).map(([tag,description])=><div class="cast-tags-glossary-entry"><dt>#{tag}</dt><dd>{description}</dd></div>)}
    </dl>
  </details>
</div>
<div class="cast-list">{cast.map(person=><details id={`rola-${person.id}`} class="cast-entry" data-search={`${person.name} ${person.arcanaName} ${person.role} ${(roleContentAdvisories[person.id]?.tags??[]).map(tag=>`#${tag}`).join(" ")}`.toLocaleLowerCase('pl')}><summary><span class="cast-no">{person.arcana}</span><span class="cast-summary-identity"><strong class="tarot-name">{tarotReady && <img class="tarot-name-symbol" src={tarotByArcana.get(person.arcana).symbol} alt="" loading="lazy"/>}{person.name}</strong><small>{person.age} lat · {person.role}</small></span><span class="cast-summary-arcana">{person.arcanaName}<i aria-hidden="true">⌄</i></span></summary><div class="cast-portrait"><div class="cast-portrait-masthead"><span>FALL OF NEVERMORE · DRAMATIS PERSONAE</span><span>POSTAĆ {person.id} / XXI</span></div><div class="cast-portrait-heading"><div class="cast-raven" aria-hidden="true">❦</div><div><span class="cast-arcana-line">ARKANA {person.arcana} · {person.arcanaName}</span><h3 class="tarot-name">{tarotReady && <img class="tarot-name-symbol" src={tarotByArcana.get(person.arcana).symbol} alt="" loading="lazy"/>}{person.name}</h3><p class="cast-portrait-role">{person.age} lat · {person.role}</p></div></div>{tarotReady && <div class="portrait-tarot"><TarotCard card={tarotByArcana.get(person.arcana)}/></div>}<p class="cast-family-note"><strong>Pokrewieństwo i miejsce w domu</strong> {familyNotes[person.id]}</p>{(portraits[person.id]??[]).map(text=><p>{text}</p>)}
<div class="cast-theme-section" aria-label="Motywy fabularne">
  <span class="cast-theme-title">MOTYWY I WĄTKI POSTACI</span>
  <div class="cast-theme-tags">{(roleContentAdvisories[person.id]?.tags??[]).map(tag=><span class="cast-theme-tag" title={threadTagDescriptions[tag]}>#{tag}</span>)}</div>
</div>
<details class="cast-trigger-details">
  <summary><span class="cast-trigger-icon" aria-hidden="true">✥</span><span>Ujawnij treści trudne postaci <small>Możliwe drobne spoilery fabularne</small></span><span class="cast-trigger-caret" aria-hidden="true">⌄</span></summary>
  <div class="cast-trigger-content"><p><strong>Treści, które mogą pojawić się w karcie lub podczas gry:</strong></p><p>{roleContentAdvisories[person.id]?.triggers}</p><p class="cast-trigger-disclaimer">Nie wszystkie wymienione treści muszą pojawić się w scenach.</p></div>
</details>
<div class="cast-literary-colophon"><span class="cast-colophon-mark" aria-hidden="true">❦</span><span>Motyw literacki: <em>{person.poe}</em>, Edgar Allan Poe</span><span class="cast-colophon-number">{person.arcana}</span></div></div></details>)}</div>{tarotReady && <section class="tarot-gallery" id="tarot" aria-labelledby="tarot-title"><h2 id="tarot-title">Wielkie Arkana</h2><p>Talia Nevermore, inspirowana twórczością Edgara Allana Poego. Kliknij kartę, aby obejrzeć jej rewers.</p><div class="tarot-grid">{deck.map(card=><div><TarotCard card={card}/>{card.person && <a class="tarot-person-link" href={`#rola-${card.person.id}`}>{card.person.name} ↗</a>}</div>)}</div></section>}<script is:inline>document.addEventListener('click',e=>{const a=e.target.closest('.genealogy-plate svg a, [data-genealogy-inspector-link], .tarot-person-link');if(!a)return;const d=document.querySelector(a.getAttribute('href'));if(d){d.open=true;d.hidden=false;const s=document.querySelector('#cast-search');if(s)s.value='';document.querySelectorAll('.cast-entry').forEach(el=>el.hidden=false)}});document.addEventListener('input',e=>{if(e.target?.id!=='cast-search')return;const q=e.target.value.trim().toLocaleLowerCase('pl');document.querySelectorAll('.cast-entry').forEach(el=>{el.hidden=!el.dataset.search.includes(q)})})</script></div> : chapter.paragraphs.map(p=><p>{p}</p>)}{chapter.slug==='swiat' && <aside class="chronicle-invitation" style="margin:2.5rem 0;padding:1.5rem;text-align:center;border:3px double #ab9276;background:rgba(255,250,240,.35)"><span class="eyebrow">Ex libris · Ravensmoor</span><h2>Z kronik rodu Ravensmoor</h2><p><em>Domus Manet.</em> Od ziem nad Raven Mere do jesieni roku 1905.</p><a href="/kronika/">Otwórz kronikę rodu →</a></aside>}</div><div class="chapter-floral-ending" aria-hidden="true"><span>❦</span></div><nav class="pager"><a href={previous?`/dokument/${previous.slug}/`:'/'}><small>← Poprzednia strona</small><strong>{previous?.title??'Strona tytułowa'}</strong></a>{next&&<a href={`/dokument/${next.slug}/`}><small>Następny rozdział →</small><strong>{next.title}</strong></a>}</nav></article></Base>

<style>
.article--mechanika .mechanics-subheading{font:600 28px/1.2 'Cormorant Garamond',serif;color:#704453;margin:0 0 15px}
.mechanics-plates{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:20px 0 28px}
.mechanics-plate{padding:20px 14px;border:3px double currentColor;text-align:center;background:#f0e6d7;color:#68516c}
.mechanics-plate--heart{color:#8c4651}.mechanics-plate--hourglass{color:#8b7148}
.mechanics-plate svg{display:block;margin:0 auto 12px}.mechanics-plate h3{font:600 26px/1.15 'Cormorant Garamond',serif;margin:0 0 5px}.mechanics-plate em{display:block;font:italic 18px 'Cormorant Garamond',serif;margin-bottom:12px}.mechanics-plate p{font:18px/1.4 'Cormorant Garamond',serif;margin:12px 0 0!important;color:#42343a}.mechanics-plate p:first-letter{float:none!important;font:inherit!important;padding:0!important;color:inherit!important}
.mechanics-plates--lights{grid-template-columns:repeat(2,minmax(0,1fr))}.mechanics-plate--blue,.mechanics-plate--violet{background:#272731;color:#b4dcff;border-color:#7e9bbf}.mechanics-plate--violet{background:#302636;color:#e3c1ff;border-color:#a785c4}.mechanics-plates--lights h3{font:600 19px/1.3 'Cormorant Garamond',serif}.mechanics-plates--lights p{color:#f0e7f2}.mechanics-plates--lights svg{filter:drop-shadow(0 0 13px currentColor)}
@media(max-width:650px){.mechanics-plates,.mechanics-plates--lights{grid-template-columns:1fr}.mechanics-plate{padding:20px}}

/* Visual pass — chapter V: rules remain verbatim, emphasis is presentation only. */
.rules-index{margin:22px 0 34px;padding:19px 22px;border-block:3px double #af967d;background:#f5ecde77}
.rules-index-title{display:block;font:600 11px/1.4 'DM Sans',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#784955;margin-bottom:12px}
.rules-index>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px 24px}
.rules-index a{font:500 14px/1.5 'DM Sans',sans-serif;text-decoration:none;padding:7px 0;border-bottom:1px solid #baaa963f;color:#573a43}
.rules-index a:hover{text-decoration:underline;color:#8c3e4c}
.article--mechanika .chapter-section{scroll-margin-top:25px}
.article--mechanika .chapter-section>p{font-size:22px;line-height:1.48;margin-bottom:18px}
.article--mechanika .chapter-section>p:first-of-type::first-letter{float:none;font:inherit;color:inherit;padding:0}
.article--mechanika .rule-subsection{margin-top:0;padding:18px 20px 8px;border-left:2px solid #af9275;border-top:0;background:#f5ecdf55}
.article--mechanika .rule-principle{font:600 clamp(30px,4vw,44px)/1.12 'Cormorant Garamond',serif!important;text-align:center;letter-spacing:.01em;color:#68323e;border-block:3px double #a88d70;padding:20px 12px}
.article--mechanika .mechanics-note{padding:15px 18px;border:1px solid #b8aa97;border-left:5px solid var(--signal);background:var(--signal-bg);margin:9px 0!important;border-radius:0;box-shadow:none;color:#302c29}
.article--mechanika .mechanics-note strong{display:block;font:700 13px/1.3 'DM Sans',sans-serif;letter-spacing:.12em;color:var(--signal);margin-bottom:5px}
.article--mechanika .mechanics-note--green{--signal:#385c43;--signal-bg:#e4ede2}
.article--mechanika .mechanics-note--yellow{--signal:#795b18;--signal-bg:#f5e9c9}
.article--mechanika .mechanics-note--red{--signal:#8b2939;--signal-bg:#f1dcdf}
.article--mechanika .rule-important,.article--mechanika .rule-mg,.article--mechanika .rule-prohibition{padding:14px 17px;border-left:4px solid #926e50;background:#f4e9d8;font-weight:600}
.article--mechanika .rule-mg{border-color:#856743;background:#eee2cd}
.article--mechanika .rule-mg::before{content:'Konsultacja z MG';display:block;font:600 10px/1.4 'DM Sans',sans-serif;letter-spacing:.11em;text-transform:uppercase;color:#72532c;margin-bottom:7px}
.article--mechanika .rule-prohibition{border-color:#8b3640;background:#f1dfe0;color:#662831}
.article--mechanika .rule-step{padding:11px 14px;margin:5px 0!important;background:#f6eee1;border-left:2px solid #ad8a70}
.article--mechanika .rule-gesture,.article--mechanika .rule-declaration{padding:10px 14px;margin:6px 0!important;border-bottom:1px solid #bbaa96;background:#f5ebdc88}
.article--mechanika .rule-gesture strong,.article--mechanika .rule-declaration strong{color:#653e47}
.article--mechanika .rule-list{margin:5px 0!important;padding-left:22px;position:relative}
.article--mechanika .rule-list::before{content:'◆';position:absolute;left:0;top:.65em;font-size:9px;color:#8b3640}
.mechanics-plate--eye{color:#455b78;border-color:#7589a0}
.mechanics-plate{box-shadow:inset 0 0 0 4px #fff6e52c}
.mechanics-plate--blue,.mechanics-plate--violet{box-shadow:inset 0 0 0 4px #ffffff09}
.article--dramaturgia .chapter-section--piatek-przybycie-gosci,.article--dramaturgia .chapter-section--sobota-dzien-wesela,.article--dramaturgia .chapter-section--niedziela{padding:22px 26px 8px;border:1px solid #b39b80;background:#f5ebdcaa;margin-block:16px}
.act-kicker{display:block;font:600 11px/1.4 'DM Sans',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#824652;margin-bottom:12px}
.article--dramaturgia .chapter-section--gra-w-epitafia{border:5px double #393036;padding:25px;background:#eee5d8}
.article--dramaturgia .chapter-section--godzina-duchow{border-left:3px solid #7d6a8a;padding-left:22px}
@media(max-width:650px){.rules-index{padding:15px}.rules-index>div{grid-template-columns:1fr}.article--mechanika .chapter-section>p{font-size:20px}.article--mechanika .rule-subsection{padding:15px 13px 5px}.article--dramaturgia .chapter-section--gra-w-epitafia,.article--dramaturgia .chapter-section--piatek-przybycie-gosci,.article--dramaturgia .chapter-section--sobota-dzien-wesela,.article--dramaturgia .chapter-section--niedziela{padding:18px 15px 6px}}
.tarot-name{display:flex;align-items:center;gap:8px}.tarot-name-symbol{width:27px;height:27px;object-fit:contain;flex:none}.cast-portrait-heading .tarot-name-symbol{width:34px;height:34px}.portrait-tarot{float:right;width:clamp(145px,35%,250px);margin:0 0 14px 18px}.cast-theme-section{clear:both}.tarot-gallery{margin:45px 0;border-top:3px double #a98b73;padding-top:28px}.tarot-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px 14px}.tarot-person-link{display:block;text-align:center;font:500 13px/1.4 'DM Sans',sans-serif;margin:8px 0;color:#713c49}.tarot-gallery h2{font-size:38px;color:#51313e}@media(max-width:600px){.tarot-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 8px}.portrait-tarot{float:none;width:100%;max-width:245px;margin:12px auto 22px}.tarot-name-symbol{width:22px;height:22px}}
</style>
