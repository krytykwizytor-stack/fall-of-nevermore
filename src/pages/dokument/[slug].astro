---
import Base from '../../layouts/Base.astro';
import { chapters } from '../../data/chapters.js';
export function getStaticPaths(){return chapters.map(chapter=>({params:{slug:chapter.slug},props:{chapter}}));}
const {chapter}=Astro.props;
const index=chapters.findIndex(c=>c.slug===chapter.slug);
const previous=chapters[index-1],next=chapters[index+1];
---
<Base title={chapter.title} active={chapter.slug}><article class="article"><div class="article-meta"><a href="/">← Spis treści</a><span>Rozdział {chapter.number} / VI</span></div><div class="article-head"><span class="chapter-watermark">{chapter.number}</span><div class="eyebrow">Fall of Nevermore · Anno Domini MCMV</div><h1>{chapter.title}</h1><p>{chapter.description}</p></div><div class="ornament-line">✦</div><div class="article-body">{chapter.paragraphs.map(p=><p>{p}</p>)}</div><div class="chapter-floral-ending" aria-hidden="true"><span>❦</span></div><nav class="pager"><a href={previous?`/dokument/${previous.slug}/`:'/'}><small>← Poprzednia strona</small><strong>{previous?.title??'Strona tytułowa'}</strong></a>{next&&<a href={`/dokument/${next.slug}/`}><small>Następny rozdział →</small><strong>{next.title}</strong></a>}</nav></article></Base>
