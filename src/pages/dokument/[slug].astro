---
import Base from '../../layouts/Base.astro';
import { chapters } from '../../data/chapters.js';
export function getStaticPaths(){return chapters.map(chapter=>({params:{slug:chapter.slug},props:{chapter}}));}
const {chapter}=Astro.props;
const index=chapters.findIndex(c=>c.slug===chapter.slug);
const previous=chapters[index-1],next=chapters[index+1];
---
<Base title={chapter.title} active={chapter.slug}><article class="article"><div class="article-meta"><a href="/">← Spis treści</a><span>Rozdział {chapter.number} / VI</span></div><div class="article-head"><span class="chapter-watermark">{chapter.number}</span><div class="eyebrow">Fall of Nevermore · Anno Domini MCMV</div><h1>{chapter.title}</h1><p>{chapter.description}</p></div><div class="ornament-line">✦</div><figure class="chapter-plate"><img src="https://commons.wikimedia.org/wiki/Special:FilePath/Gothic_Ornaments%2C_selected_fom_various_ancient_buildings%2C_both_in_England_and_Franc%2C_during_the_years_1828%2C_1829%2C_and_1839_-_Agustus_Pugin_16.jpeg" loading="lazy" alt="Historyczny ornament gotycki — rycina z 1831 roku"/><figcaption>Studium ornamentu · A. Pugin, 1831</figcaption></figure><div class="article-body">{chapter.paragraphs.map(p=><p>{p}</p>)}</div><nav class="pager"><a href={previous?`/dokument/${previous.slug}/`:'/'}><small>← Poprzednia strona</small><strong>{previous?.title??'Strona tytułowa'}</strong></a>{next&&<a href={`/dokument/${next.slug}/`}><small>Następny rozdział →</small><strong>{next.title}</strong></a>}</nav></article></Base>
