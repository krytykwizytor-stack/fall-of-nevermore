---
import Base from '../../layouts/Base.astro';
import { chapters } from '../../data/chapters.js';
import { cast } from '../../data/cast.js';
import { familyNotes } from '../../data/familyNotes.js';
import Genealogy from '../../components/Genealogy.astro';
import { portraitsA } from '../../data/portraits-a.js';
import { portraitsB } from '../../data/portraits-b.js';
import { portraitsC } from '../../data/portraits-c.js';
import { portraitsD } from '../../data/portraits-d.js';
import { portraitsE } from '../../data/portraits-e.js';
import { portraitsF } from '../../data/portraits-f.js';
import { portraitsG } from '../../data/portraits-g.js';
import { portraitsH } from '../../data/portraits-h.js';
const portraits={...portraitsA,...portraitsB,...portraitsC,...portraitsD,...portraitsE,...portraitsF,...portraitsG,...portraitsH};
export function getStaticPaths(){return chapters.map(chapter=>({params:{slug:chapter.slug},props:{chapter}}));}
const {chapter}=Astro.props;
const index=chapters.findIndex(c=>c.slug===chapter.slug);
const previous=chapters[index-1],next=chapters[index+1];
---
<Base title={chapter.title} active={chapter.slug}><article class:list={["article", `article--${chapter.slug}`]}><div class="article-meta"><a href="/">← Spis treści</a><span>Rozdział {chapter.number} / VI</span></div><div class="article-head"><span class="chapter-watermark">{chapter.number}</span><div class="eyebrow">Fall of Nevermore · Anno Domini MCMV</div><h1>{chapter.title}</h1><p>{chapter.description}</p></div><div class="ornament-line">✦</div><div class="article-folio" aria-hidden="true">RAVENSMOOR · MCMV</div><div class="article-body">{chapter.sections ? chapter.sections.map((section, i) => <section class:list={["chapter-section", {"chapter-section--crowe":chapter.slug==="swiat" && section.heading==="Rodzina Crowe\'ów"}]} id={`sekcja-${i+1}`} aria-labelledby={`section-${i+1}`}><h2 id={`section-${i+1}`}>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}</section>) : chapter.slug==='postacie' ? <div class="cast-index"><div class="cast-intro">{chapter.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div><p class="cast-instruction">Wybierz nazwisko w rodowodzie lub rozwiń portret w katalogu. Możesz również wyszukać postać po imieniu lub Arkanie.</p><label for="cast-search">Szukaj postaci</label><input id="cast-search" type="search" placeholder="Imię, nazwisko lub Arkana"/><Genealogy /><div class="cast-list">{cast.map(person=><details id={`rola-${person.id}`} class="cast-entry" data-search={`${person.name} ${person.arcanaName} ${person.role}`.toLocaleLowerCase('pl')}><summary><span class="cast-no">{person.arcana}</span><span><strong>{person.name}</strong><small>{person.age} lat · {person.role} · {person.arcanaName}</small></span><span aria-hidden="true">❦</span></summary><div class="cast-portrait"><p class="cast-family-note"><strong>Pokrewieństwo i miejsce w domu</strong> {familyNotes[person.id]}</p>{(portraits[person.id]??[`${person.name} zajmuje własne miejsce pośród mieszkańców i gości Nevermore Hall. Jego obecność zapowiada spotkania, które nie pozostaną bez znaczenia.`]).map(text=><p>{text}</p>)}<small>Inspiracja ikonograficzna: {person.poe}</small></div></details>)}</div><script is:inline>document.addEventListener('click',e=>{const a=e.target.closest('.genealogy-plate svg a');if(!a)return;const d=document.querySelector(a.getAttribute('href'));if(d){d.open=true;d.hidden=false;const s=document.querySelector('#cast-search');if(s)s.value='';document.querySelectorAll('.cast-entry').forEach(el=>el.hidden=false)}});document.addEventListener('input',e=>{if(e.target?.id!=='cast-search')return;const q=e.target.value.trim().toLocaleLowerCase('pl');document.querySelectorAll('.cast-entry').forEach(el=>{el.hidden=!el.dataset.search.includes(q)})})</script></div> : chapter.paragraphs.map(p=><p>{p}</p>)}</div><div class="chapter-floral-ending" aria-hidden="true"><span>❦</span></div><nav class="pager"><a href={previous?`/dokument/${previous.slug}/`:'/'}><small>← Poprzednia strona</small><strong>{previous?.title??'Strona tytułowa'}</strong></a>{next&&<a href={`/dokument/${next.slug}/`}><small>Następny rozdział →</small><strong>{next.title}</strong></a>}</nav></article></Base>
