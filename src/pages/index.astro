---
import Base from '../layouts/Base.astro';
import { chapters } from '../data/chapters.js';
import InvitationLetter from '../components/InvitationLetter.astro';
---
<Base><section class="cover"><div class="cover-engraving" aria-hidden="true"></div><span class="cover-quill cover-quill--left" aria-hidden="true"></span><span class="cover-quill cover-quill--right" aria-hidden="true"></span><div class="cover-ornament">✦ &nbsp; ❦ &nbsp; ✦</div><p class="eyebrow">Anno Domini MCMV · The House of Ravensmoor</p><h1 class="cover-logo-heading"><img class="cover-official-logo" src="/images/identity/fon-logo-white.png" width="700" height="295" alt="Fall of Nevermore" decoding="async" fetchpriority="high"/></h1><div class="flourish">❦</div><p class="subtitle">Neogotycki larp o rodzinie,<br/>pamięci i dziedzictwie</p><p class="cover-desc">Opowieść o dziedzictwie, zobowiązaniach i tym, co pozostaje w cieniu rodzinnej historii.</p><div class="cover-links"><a class="start" href="/dokument/koncepcja/">Poznaj Nevermore ↗</a><a class="cover-info-link" href="/dokument/informacje/">Informacje praktyczne ↗</a></div><div class="cover-bottom"><span>Ravensmoor</span><span>Est. 1905</span><span>F / N</span></div></section><InvitationLetter/><section class="gothic-epigraph" aria-label="Epigraf"><blockquote>“And my soul from out that shadow that lies floating on the floor<br/>Shall be lifted—nevermore!”</blockquote><cite>Edgar Allan Poe · The Raven (1845)</cite></section><section class="introduction editorial-wash"><div><span class="eyebrow">Wprowadzenie</span><h2>Przed wejściem do Nevermore</h2></div><div><p>Lord Ambrose Ravensmoor zaprosił krewnych do Nevermore Hall, aby ogłosić ostatnią wolę. W domu trwają zarazem przygotowania do ślubu Sebastiana. Dla części rodziny będzie to pierwsze spotkanie od wielu lat.</p><p>Przed przyjazdem możesz poznać dzieje domu i jego mieszkańców, przeczytać o konwencji oraz sprawdzić <a href="/dokument/informacje/">informacje organizacyjne</a>.</p></div></section><div class="editorial-rule" aria-hidden="true"></div><section class="contents decorative-contents"><span class="eyebrow">Index rerum</span><h2>Spis rozdziałów</h2><div class="chapter-grid">{chapters.map(c=><a class="chapter-card" href={`/dokument/${c.slug}/`}><span>{c.number}</span><div><h3>{c.title}</h3><p>{c.description}</p></div><b>↗</b></a>)}</div></section></Base>
