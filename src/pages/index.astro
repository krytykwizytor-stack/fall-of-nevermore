---
import Base from '../layouts/Base.astro';
import { chapters } from '../data/chapters.js';
---
<Base><section class="cover"><div class="cover-engraving" aria-hidden="true"></div><div class="cover-ornament">✦ &nbsp; ❦ &nbsp; ✦</div><p class="eyebrow">Anno Domini MCMV · The House of Ravensmoor</p><h1>Fall <i>of</i><br/>Nevermore</h1><div class="flourish">❦</div><p class="subtitle">Neogotycki larp o rodzinie,<br/>pamięci i dziedzictwie</p><p class="cover-desc">Opowieść o dziedzictwie, zobowiązaniach i tym, co pozostaje w cieniu rodzinnej historii.</p><a class="start" href="/dokument/koncepcja/">Poznaj Nevermore ↗</a><div class="cover-bottom"><span>Ravensmoor</span><span>Est. 1905</span><span>F / N</span></div></section><section class="engraving-section"><div class="engraving-frame"><img src="https://commons.wikimedia.org/wiki/Special:FilePath/Dore_The_Raven_1884-22.jpg" alt="Rycina Gustave’a Dorégo do Kruka (1884)" loading="lazy"/></div><div><span class="eyebrow">Memento mori · 1884</span><h2>W cieniu opowieści</h2><p>Wyobraźnia neogotyku, pamięć i strata przenikają historię Nevermore, splatając codzienność z tym, czego nie da się zapomnieć.</p><small>Gustave Doré, ilustracja do The Raven, 1884</small></div></section><section class="gothic-epigraph" aria-label="Epigraf"><blockquote>“And my soul from out that shadow that lies floating on the floor<br/>Shall be lifted—nevermore!”</blockquote><cite>Edgar Allan Poe · The Raven (1845)</cite></section><section class="introduction"><div><span class="eyebrow">Wprowadzenie</span><h2>Dom, który pamięta</h2></div><div><p><em>Fall of Nevermore</em> zaprasza do świata, w którym nazwisko jest obietnicą, a przeszłość zbyt łatwo staje się teraźniejszością. W roku 1905 losy rodu Ravensmoorów splatają się z opowieścią o lojalności, przemijaniu i dziedzictwie.</p><p>W kolejnych rozdziałach poznasz konwencję gry, świat Nevermore, bohaterów i zasady wspólnego tworzenia historii.</p></div></section><section class="gothic-miniature"><div><span class="eyebrow">Rok tysiąc dziewięćset piąty</span><h2>Dziedzictwo ma swoją cenę</h2><p>Gdy pokolenia odchodzą, pozostawiają po sobie więcej niż majątek i nazwisko. Niektóre historie dziedziczy się wbrew własnej woli.</p><small>Ilustracja: Gustave Doré, <em>The Raven</em> (1884)</small></div><img src="https://commons.wikimedia.org/wiki/Special:FilePath/Dore_The_Raven_1884-12.jpg" loading="lazy" alt="Historyczna rycina Gustave’a Dorégo do poematu Kruk"/></section><section class="contents"><span class="eyebrow">Index rerum</span><h2>Spis rozdziałów</h2><div class="chapter-grid">{chapters.map(c=><a class="chapter-card" href={`/dokument/${c.slug}/`}><span>{c.number}</span><div><h3>{c.title}</h3><p>{c.description}</p></div><b>↗</b></a>)}</div></section></Base>
