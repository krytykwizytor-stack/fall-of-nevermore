---
import Base from '../layouts/Base.astro';
import { chapters } from '../data/chapters.js';
---
<Base><section class="cover"><div class="cover-engraving" aria-hidden="true"></div><div class="cover-ornament">✦ &nbsp; ❦ &nbsp; ✦</div><p class="eyebrow">Anno Domini MCMV · The House of Ravensmoor</p><h1>Fall <i>of</i><br/>Nevermore</h1><div class="flourish">❦</div><p class="subtitle">Neogotycki larp o rodzinie,<br/>pamięci i dziedzictwie</p><p class="cover-desc">Opowieść o dziedzictwie, zobowiązaniach i tym, co pozostaje w cieniu rodzinnej historii.</p><a class="start" href="/dokument/koncepcja/">Poznaj Nevermore ↗</a><div class="cover-bottom"><span>Ravensmoor</span><span>Est. 1905</span><span>F / N</span></div></section><section class="gothic-epigraph" aria-label="Epigraf"><blockquote>“And my soul from out that shadow that lies floating on the floor<br/>Shall be lifted—nevermore!”</blockquote><cite>Edgar Allan Poe · The Raven (1845)</cite></section><section class="introduction editorial-wash"><div><span class="eyebrow">Wprowadzenie</span><h2>Dom, który pamięta</h2></div><div><p><em>Fall of Nevermore</em> zaprasza do świata, w którym nazwisko jest obietnicą, a przeszłość zbyt łatwo staje się teraźniejszością. W roku 1905 losy rodu Ravensmoorów splatają się z opowieścią o lojalności, przemijaniu i dziedzictwie.</p><p>W kolejnych rozdziałach poznasz konwencję gry, świat Nevermore, bohaterów i zasady wspólnego tworzenia historii.</p></div></section><div class="editorial-rule" aria-hidden="true"></div><section class="contents decorative-contents"><span class="eyebrow">Index rerum</span><h2>Spis rozdziałów</h2><div class="chapter-grid">{chapters.map(c=><a class="chapter-card" href={`/dokument/${c.slug}/`}><span>{c.number}</span><div><h3>{c.title}</h3><p>{c.description}</p></div><b>↗</b></a>)}</div></section></Base>
