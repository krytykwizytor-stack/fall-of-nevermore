---
import {tarotBack} from '../data/tarot.js';
const {card}=Astro.props;
---
<figure class="tarot-figure">
 <div class="tarot-ink">
 <button type="button" class="tarot-turn" aria-label={`Odwróć kartę: ${card.name}`} aria-pressed="false" data-tarot-turn>
  <span class="tarot-faces"><img class="tarot-front" src={card.card} alt={`${card.arcana} — ${card.name}`} loading="lazy" decoding="async"/><img class="tarot-back" src={tarotBack} alt="" loading="lazy" decoding="async"/></span>
 </button>
 </div>
 <figcaption><strong>{card.arcana} · {card.name}</strong><em>{card.poe}</em></figcaption>
</figure>
<style>
.tarot-figure{margin:0;min-width:0;text-align:center}.tarot-ink{position:relative;isolation:isolate;padding:17px 10px 12px}.tarot-ink::before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 45% 45%,#3b2529b0 0%,#65404980 35%,#72464e30 56%,transparent 72%);border-radius:42% 57% 38% 62%;transform:rotate(-7deg);pointer-events:none}.tarot-turn{display:block;width:100%;max-width:245px;margin:auto;padding:0;background:none;border:0;cursor:pointer;perspective:1000px;color:inherit}.tarot-turn:focus-visible{outline:2px solid #874356;outline-offset:5px}.tarot-faces{display:grid;transform-style:preserve-3d;transition:transform .65s ease}.tarot-faces img{display:block;grid-area:1/1;width:100%;height:100%;object-fit:contain;backface-visibility:hidden;filter:drop-shadow(0 6px 8px #23161b55)}.tarot-back{transform:rotateY(180deg)}.tarot-turn[aria-pressed=true] .tarot-faces{transform:rotateY(180deg)}.tarot-figure figcaption{display:grid;gap:3px;font:500 20px/1.2 'Cormorant Garamond',serif;color:#543640}.tarot-figure figcaption em{font-size:16px}.tarot-figure.is-revealed .tarot-ink{animation:tarot-emerge 1.1s ease-out both}@keyframes tarot-emerge{from{opacity:.12;transform:translateY(10px) scale(.95);filter:blur(3px)}to{opacity:1;transform:none;filter:none}}@media(prefers-reduced-motion:reduce){.tarot-faces{transition:none}.tarot-figure.is-revealed .tarot-ink{animation:none}}
</style>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-tarot-turn]').forEach(button=>button.addEventListener('click',()=>button.setAttribute('aria-pressed',String(button.getAttribute('aria-pressed')!=='true'))));
if('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches){
 const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('is-revealed');observer.unobserve(entry.target)}}},{threshold:.15});
 document.querySelectorAll('.tarot-figure').forEach(el=>observer.observe(el));
}
</script>
