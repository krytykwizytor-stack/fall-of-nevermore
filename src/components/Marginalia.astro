---
import { marginalia } from '../data/marginalia.js';
const { slug, section } = Astro.props;
const note = marginalia[slug]?.[section];
---
{note && <aside class:list={["folio-marginalia",note.side === "left" ? "folio-marginalia--left" : "folio-marginalia--right"]} aria-label="Notatka na marginesie">
  <span class="folio-marginalia__symbol" aria-hidden="true">❧</span>
  <span class="folio-marginalia__sign">{note.sign}</span>
  <p>{note.body}</p>
</aside>}
