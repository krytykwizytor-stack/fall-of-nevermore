---
import { genealogy } from '../data/genealogy.js';
const nodes = new Map(genealogy.nodes.map(n=>[n.id,n]));
const relations = genealogy.relations.map(r=>({...r,a:nodes.get(r.from),b:nodes.get(r.to)}));
---
<section class="genealogy-plate" aria-labelledby="genealogy-heading">
<h2 id="genealogy-heading">Tablica genealogiczna Ravensmoorów</h2>
<p>Wybierz osobę w rodowodzie, aby otworzyć jej portret. Linie wskazują tylko potwierdzone związki.</p>
<div class="genealogy-scroll" tabindex="0" aria-label="Przewijana plansza genealogiczna">
<svg viewBox="0 0 1380 1100" role="img" aria-label="Genealogia rodziny Ravensmoorów i publicznie znane relacje z gośćmi" xmlns="http://www.w3.org/2000/svg">
<rect x="8" y="8" width="1364" height="1084" rx="5" fill="none" stroke="#a0806c" stroke-width="1"/>
<rect x="18" y="18" width="1344" height="1064" rx="2" fill="none" stroke="#baa48c" stroke-width=".8"/>
<text x="690" y="37" text-anchor="middle" font-size="12" letter-spacing="4" fill="#765664">DOMUS RAVENSMOOR</text>
{relations.map(link => <line x1={link.type==='marriage'?link.a.x+68:link.a.x} y1={link.type==='marriage'?link.a.y:link.a.y+29} x2={link.type==='marriage'?link.b.x-68:link.b.x} y2={link.type==='marriage'?link.b.y:link.b.y-29} stroke={link.type==='parent'?'#846a60':'#a17b83'} stroke-width={link.type==='parent'?1.5:1.2} stroke-dasharray={link.type==='engagement'?'7 4':link.type==='public_friendship'?'2 5':undefined} />)}
{genealogy.nodes.map(node => <g>
<rect x={node.x-66} y={node.y-28} width="132" height="56" rx="2" fill={node.kind==='guest'?'#eee4d9':'#f6ede0'} stroke={node.kind==='guest'?'#b5a598':'#8e6870'} stroke-width="1.1"/>
{node.id==='basilius'||node.id==='lucinda' ? <text x={node.x} y={node.y+4} text-anchor="middle" font-size="16" font-family="Cormorant Garamond,serif" fill="#442b36">{node.label}</text> : <a href={'#rola-'+node.id} aria-label={'Otwórz portret: '+node.label}><rect x={node.x-65} y={node.y-27} width="130" height="54" fill="transparent"/><text x={node.x} y={node.y+4} text-anchor="middle" font-size="17" font-family="Cormorant Garamond,serif" fill="#52313d" text-decoration="underline">{node.label}</text></a>}
<text x={node.x} y={node.y+19} text-anchor="middle" font-size="10" font-family="Cormorant Garamond,serif" fill="#78665f">{node.sub}</text></g>)}
<text x="690" y="1080" text-anchor="middle" font-size="13" fill="#826657" font-family="Cormorant Garamond,serif">Genealogia i związki domu Nevermore · MCMV</text>
</svg>
</div>
<p class="genealogy-caption">Linia ciągła: pokrewieństwo lub małżeństwo · przerywana: zaręczyny · kropkowana: publiczna przyjaźń. Pokazano trzy linie potomków Basiliusa oraz osoby związane z domem.</p>
</section>
