---
import { genealogy } from '../data/genealogy.js';
import { familyNotes } from '../data/familyNotes.js';
import { cast } from '../data/cast.js';
const nodes = new Map(genealogy.nodes.map(node=>[node.id,node]));
const castById = new Map(cast.map(person=>[person.id,person]));
const relations = genealogy.relations.map(r=>({...r,a:nodes.get(r.from),b:nodes.get(r.to)}));
const lineKind = {
  parent:'blood', marriage:'marriage', engagement:'engagement', public_friendship:'friendship'
};
---
<section class="genealogy-plate" aria-labelledby="genealogy-heading">
  <div class="genealogy-intro">
    <span class="genealogy-kicker">ARCHIVUM FAMILIAE · ANNO DOMINI MCMV</span>
    <h2 id="genealogy-heading">Rodowód domu Ravensmoor</h2>
    <p>Wskaż postać, aby zobaczyć jej więzi rodzinne. Kliknij nazwisko, by przejść do portretu.</p>
  </div>
  <div class="genealogy-scroll" tabindex="0" aria-label="Przewijana tablica genealogiczna Ravensmoorów">
    <svg class="genealogy-chart" viewBox="0 0 1380 1100" role="img" aria-label="Drzewo genealogiczne Ravensmoorów" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="genealogy-paper" width="24" height="24" patternUnits="userSpaceOnUse">
          <path d="M0 24L24 0" stroke="#9b8173" stroke-width=".25" opacity=".19"/>
        </pattern>
        <linearGradient id="genealogy-vellum" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f8f0e1"/>
          <stop offset=".52" stop-color="#f0e5d4"/>
          <stop offset="1" stop-color="#eadccb"/>
        </linearGradient>
      </defs>
      <rect width="1380" height="1100" rx="6" fill="url(#genealogy-vellum)"/>
      <rect width="1380" height="1100" fill="url(#genealogy-paper)"/>
      <rect x="9" y="9" width="1362" height="1082" rx="3" fill="none" stroke="#77545e" stroke-width="1.6"/>
      <rect x="18" y="18" width="1344" height="1064" rx="2" fill="none" stroke="#b89b7d" stroke-width="1"/>
      <path d="M29 104V29H104 M1276 29H1351V104 M29 996V1071H104 M1276 1071H1351V996" fill="none" stroke="#825565" stroke-width="2"/>
      <path d="M38 96V38H96 M1284 38H1342V96 M38 1004V1062H96 M1284 1062H1342V1004" fill="none" stroke="#c5a77e" stroke-width="1"/>
      <g fill="#795161" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif">
        <text x="690" y="49" font-size="15" letter-spacing="5">✦ DOMUS RAVENSMOOR ✦</text>
        <text x="690" y="1064" font-size="17" letter-spacing="2">✥  FAMILIA · SANGUIS · MEMORIA  ✥</text>
      </g>
      <g class="genealogy-connections">
        {relations.map(link => <line
          x1={link.type==='marriage' ? link.a.x+68 : link.a.x}
          y1={link.type==='marriage' ? link.a.y : link.a.y+37}
          x2={link.type==='marriage' ? link.b.x-68 : link.b.x}
          y2={link.type==='marriage' ? link.b.y : link.b.y-37}
          stroke={link.type==='parent'?'#774452':link.type==='marriage'?'#ac8357':'#987b70'}
          stroke-width={link.type==='parent'?2.8:link.type==='marriage'?3:1.8}
          stroke-dasharray={link.type==='engagement'?'9 6':link.type==='public_friendship'?'2 7':undefined}
          stroke-linecap="round"
          class={`relation relation--${lineKind[link.type]}`}
          data-from={link.from}
          data-to={link.to}
        />)}
        {relations.filter(link=>link.type==='marriage').map(link => <g aria-label="Małżeństwo" class="genealogy-marriage-mark" transform={`translate(${(link.a.x+link.b.x)/2},${(link.a.y+link.b.y)/2})`}>
          <rect x="-12" y="-11" width="24" height="22" rx="7" fill="#f5ead9" stroke="#ad875b" stroke-width=".85"/>
          <text x="0" y="6" font-family="Georgia,serif" text-anchor="middle" font-size="19" font-weight="700" fill="#906637">⚭</text>
        </g>)}
      </g>
      {genealogy.nodes.map(node => <g class:list={['genealogy-person',`genealogy-person--${node.kind}`]} data-person-id={node.id} data-person-label={castById.get(node.id)?.name ?? node.label} data-person-note={familyNotes[node.id] ?? node.sub} data-person-arcana={castById.get(node.id)?.arcanaName ?? (node.kind==='deceased'?'Osoba zmarła':'Starsze pokolenie')}>
        <rect x={node.x-73} y={node.y-38} width="146" height="76" rx="3"
          fill={node.kind==='deceased'?'#e2d6ca':node.kind==='guest'?'#eee6da':'#f9f1e5'}
          stroke={node.kind==='deceased'?'#938080':node.kind==='guest'?'#aa957e':'#815661'}
          stroke-width="1.4"/>
        <rect x={node.x-69} y={node.y-34} width="138" height="68" rx="1" fill="none" stroke="#bb9b80" stroke-width=".55"/>
        {node.kind==='deceased' && <text x={node.x-57} y={node.y-11} fill="#8b5761" font-size="20" font-family="Georgia, serif" aria-label="Osoba zmarła">†</text>}
        {node.kind==='ancestor' && <text x={node.x-57} y={node.y-12} fill="#8b5761" font-size="14">✥</text>}
        {node.kind==='deceased'||node.kind==='ancestor'
          ? <text x={node.x} y={node.y-11} text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="18" font-weight="600" fill="#4c313e">{node.label}</text>
          : <a href={'#rola-'+node.id} aria-label={`Otwórz portret ${node.label}, ${node.born}`}>
            <rect x={node.x-72} y={node.y-37} width="144" height="74" rx="2" fill="transparent"/>
            <text x={node.x} y={node.y-11} text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif"
              font-size={node.label.length>13?15:18} font-weight="600" fill="#51323e" text-decoration="underline">{node.label}</text>
          </a>}
        <text x={node.x} y={node.y+7} text-anchor="middle" font-family="DM Sans, sans-serif" font-size={node.sub.length>25?9:10} fill="#685861">{node.sub}</text>
        <path d={`M${node.x-24} ${node.y+14}h48`} stroke="#c7a98d" stroke-width=".8"/>
        <text x={node.x} y={node.y+28} text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="14" letter-spacing=".4" fill="#865767">{node.born}</text>
      </g>)}
    </svg>
  </div>
  <div class="genealogy-inspector" aria-live="polite" aria-atomic="true">
    <span class="genealogy-inspector__label">Z archiwum rodzinnego · wybrana osoba</span>
    <div class="genealogy-inspector__main"><div><h3 data-genealogy-inspector-name>Wybierz nazwisko</h3><p data-genealogy-inspector-note>Podświetlimy osoby związane z wybranym członkiem rodu. Rodowód przedstawia tylko jawne więzi.</p></div><a data-genealogy-inspector-link href="#rola-01" hidden>Otwórz portret ↗</a></div>
  </div>
  <div class="genealogy-legend" aria-label="Legenda linii i oznaczeń">
    <span><i class="line blood"></i> Pokrewieństwo</span>
    <span><i class="marriage-symbol" aria-hidden="true">⚭</i> Małżeństwo</span>
    <span><i class="line engagement"></i> Zaręczyny</span>
    <span><i class="line friendship"></i> Publicznie znana przyjaźń</span>
    <span><strong>†</strong> Osoba zmarła</span>
  </div>
</section>
<style>
.genealogy-plate{position:relative;margin:2.6rem 0;padding:17px;background:#eadfce;border:1px solid #957984;box-shadow:0 0 0 5px #eee5d7,0 12px 30px #392c2c18}
.genealogy-intro{text-align:center;padding:15px 12px 18px;color:#4d303b}
.genealogy-kicker{display:block;font:600 10px 'DM Sans',sans-serif;letter-spacing:.21em;color:#88636c}
.genealogy-intro h2{font:600 clamp(30px,4vw,46px)/1 'Cormorant Garamond',serif;margin:.45rem 0}
.genealogy-intro p{font:16px/1.4 'Cormorant Garamond',serif;margin:0}
.genealogy-scroll{overflow:auto;max-width:100%;border:1px solid #b29a8d;background:#f1e5d4;scrollbar-color:#9d7780 #e9dece}
.genealogy-chart{display:block;width:100%;min-width:970px;height:auto}
.genealogy-person a{cursor:pointer}
.genealogy-person a:hover text{fill:#9c5066;text-decoration-thickness:2px}
.genealogy-person a:focus-visible{outline:none}
.genealogy-person a:focus-visible rect{stroke:#9c5066;stroke-width:2px}
.genealogy-legend{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;column-gap:20px;row-gap:10px;padding:18px 12px 11px;font:12px/1.4 'DM Sans',sans-serif;color:#593e48}
.genealogy-legend>span{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
.genealogy-legend i.line{display:inline-block;width:32px;border-top:2px solid #865965}
.genealogy-legend i.engagement{border-top-style:dashed;border-color:#987b70}
.genealogy-legend i.friendship{border-top-style:dotted;border-width:3px;border-color:#987b70}
.genealogy-legend i.marriage{border-color:#ac8357}\n.genealogy-legend .marriage-symbol{font:700 22px/1 Georgia,serif;color:#906637;display:inline-flex;align-items:center;justify-content:center;width:32px;height:18px;border:1px solid #bd9a6b;border-radius:8px;background:#f5ead9}
.genealogy-legend strong{font:24px Georgia,serif;color:#865965;line-height:.6}
@media(max-width:760px){.genealogy-plate{padding:10px;margin:2rem 0}.genealogy-scroll{max-height:65vh}.genealogy-intro{padding:13px 4px}.genealogy-legend{justify-content:flex-start;padding:16px 7px}}

/* Living family-tree interactions, preserving the existing public genealogy. */
.genealogy-plate .relation{transition:stroke .24s ease,stroke-width .24s ease,opacity .24s ease}
.genealogy-plate.is-inspecting .relation:not(.is-related){opacity:.21}
.genealogy-plate.is-inspecting .relation.is-related{stroke:#a13349;stroke-width:5.8;opacity:1}
.genealogy-plate .genealogy-person{transition:opacity .2s ease}
.genealogy-plate.is-inspecting .genealogy-person:not(.is-selected):not(.is-related){opacity:.38}
.genealogy-plate .genealogy-person.is-selected>rect:first-of-type{stroke:#99374c;stroke-width:4;fill:#f9e5d5}
.genealogy-plate .genealogy-person.is-related>rect:first-of-type{stroke:#ab6472;stroke-width:2.6}
.genealogy-plate .genealogy-person.is-selected text{fill:#6c3045}
.genealogy-inspector{display:block;margin:12px 0 0;padding:18px 22px;background:linear-gradient(120deg,#e7d6c5,#f3e8db);border:1px solid rgba(139,95,91,.45);border-left:4px solid #8b495c;box-shadow:inset 0 1px rgba(255,255,255,.3)}
.genealogy-inspector__label{display:block;font:600 10px/1.4 'DM Sans',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#85616a;margin-bottom:7px}
.genealogy-inspector__main{display:flex;justify-content:space-between;align-items:center;gap:20px}
.genealogy-inspector h3{font:600 28px/1.1 'Cormorant Garamond',serif;margin:0 0 5px;color:#51313e}
.genealogy-inspector p{font:17px/1.45 'Cormorant Garamond',serif;margin:0;color:#5a4c4b}
.genealogy-inspector a{font:600 12px/1.35 'DM Sans',sans-serif;color:#734255;text-decoration:none;white-space:nowrap;border-bottom:1px solid #9a6776;padding-bottom:4px}
.genealogy-inspector a:hover{color:#a34e66;border-color:#a34e66}
@media(max-width:600px){.genealogy-inspector{padding:15px}.genealogy-inspector__main{display:block}.genealogy-inspector a{display:inline-block;margin-top:11px}.genealogy-inspector h3{font-size:25px}}
@media(prefers-reduced-motion:reduce){.genealogy-plate .relation,.genealogy-plate .genealogy-person{transition:none!important}}
</style>

<script>
  const tree=document.querySelector('.genealogy-plate');
  if(tree){
    const people=[...tree.querySelectorAll('.genealogy-person[data-person-id]')];
    const lines=[...tree.querySelectorAll('.relation[data-from][data-to]')];
    const title=tree.querySelector('[data-genealogy-inspector-name]');
    const note=tree.querySelector('[data-genealogy-inspector-note]');
    const link=tree.querySelector('[data-genealogy-inspector-link]');
    let lastId='';
    function select(person){
      const id=person?.dataset.personId;
      if(!id || id===lastId)return;
      lastId=id;
      const related=new Set([id]);
      for(const line of lines){
        const hit=line.dataset.from===id || line.dataset.to===id;
        line.classList.toggle('is-related',hit);
        if(hit)related.add(line.dataset.from===id ? line.dataset.to : line.dataset.from);
      }
      tree.classList.add('is-inspecting');
      for(const item of people){
        item.classList.toggle('is-selected',item===person);
        item.classList.toggle('is-related',item!==person && related.has(item.dataset.personId));
      }
      if(title)title.textContent=person.dataset.personLabel||'';
      if(note)note.textContent=person.dataset.personNote||'';
      if(link){
        const hasPortrait=/^\d{2}$/.test(id);
        link.hidden=!hasPortrait;
        if(hasPortrait)link.href='#rola-'+id;
      }
    }
    for(const person of people){
      person.addEventListener('pointerenter',()=>select(person));
      person.addEventListener('focusin',()=>select(person));
      person.addEventListener('click',()=>select(person));
    }
  }
</script>
